# Terminates TLS (automatic Let's Encrypt for {$PPOB2_DOMAIN}) and exposes ONLY the surfaces that
# need to be reachable from outside. Everything else answers 404 here and never reaches the app.
#
#   /api/v1/*                    partner Open API   (HMAC-signed, Section 23)
#   /internal/webhooks/ayolinx   payment callback   (signature verified by the app)
#   /admin/*                     Admin REST         (HTTP Basic + RBAC)
#
# Deliberately NOT exposed: /actuator/* (the compose healthcheck talks to the app directly) and
# /internal/settlement/* (an ops trigger; run it from the host with `docker compose exec`).
{$PPOB2_DOMAIN} {
	encode zstd gzip

	@exposed path /api/v1/* /internal/webhooks/ayolinx /admin/*
	handle @exposed {
		reverse_proxy app:8080
	}

	handle {
		respond "Not found" 404
	}
}
