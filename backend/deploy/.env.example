# Copy to deploy/.env and fill in. Never commit the filled-in file.

# --- required ------------------------------------------------------------------------------------
# Public hostname; its DNS A record must already point at this server (Caddy needs it for TLS).
PPOB2_DOMAIN=ppob2.example.com
PPOB2_DB_PASSWORD=
# base64 of 32 random bytes:  openssl rand -base64 32   (encrypts admin TOTP secrets; back it up with the DB)
PPOB2_ADMIN_MFA_ENCRYPTION_KEY=

# --- payment gateway -----------------------------------------------------------------------------
# "stub" (no real HTTP call) or "ayolinx". With "ayolinx" every PPOB2_AYOLINX_* value below is needed.
PPOB2_PAYMENT_GATEWAY=stub
PPOB2_AYOLINX_BASE_URL=https://sandbox.ayolinx.id
PPOB2_AYOLINX_CLIENT_KEY=
PPOB2_AYOLINX_CLIENT_SECRET=
# Must be public: https://<PPOB2_DOMAIN>/internal/webhooks/ayolinx
PPOB2_AYOLINX_NOTIFICATION_URL=
# PEM keys go on ONE line. The parser strips the BEGIN/END lines and all whitespace, so paste the
# base64 body (or the whole PEM with its newlines replaced by spaces). A literal "\n" does NOT work.
PPOB2_AYOLINX_PRIVATE_KEY_PEM=
PPOB2_AYOLINX_PUBLIC_KEY_PEM=

# --- optional ------------------------------------------------------------------------------------
# Settlement windows and daily quotas follow this zone. Confirm against the Ayolinx contract
# (Section 37.1) before changing it; the default reproduces the behaviour the code already had.
# PPOB2_BUSINESS_ZONE=UTC
